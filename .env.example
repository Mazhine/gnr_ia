# Copier ce fichier en .env et ajuster si besoin.
# Le préfixe MAINTIDOC_ est appliqué automatiquement par pydantic-settings.

# Racine des artefacts lourds (venv, modèles, index, corpus extrait).
# Laisser vide pour utiliser le dossier de données utilisateur par défaut :
# %LOCALAPPDATA%\maintidoc sous Windows.
# MAINTIDOC_HOME=

# Infrastructure locale (docker compose)
MAINTIDOC_QDRANT_URL=http://localhost:6333
MAINTIDOC_POSTGRES_DSN=postgresql://maintidoc:maintidoc@localhost:5432/maintidoc
MAINTIDOC_MLFLOW_URL=http://localhost:5000

# Secrets de développement uniquement. Rien de réel ici.
POSTGRES_USER=maintidoc
POSTGRES_PASSWORD=maintidoc
POSTGRES_DB=maintidoc
